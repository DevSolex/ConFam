# =============================================================================
# ConFam — Environment Variables Reference
# =============================================================================
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then fill in the REQUIRED variables marked below before running
# `docker compose up`.
#
# NEVER commit .env (it is in .gitignore).
# NEVER put real credentials in this file — it is committed to source.
#
# Engineering Rule 8: secrets live only in environment/secret-management
# systems. In production, all secrets are stored in AWS Secrets Manager.
#
# =============================================================================
# SECTION A — Docker Postgres container configuration
#
# These variables configure the Postgres container itself (postgres service in
# docker-compose.yml). They are NOT the same as the app's DATABASE_URL —
# they are what Docker's official Postgres image uses to initialise the
# container on first run.
#
# REQUIRED before `docker compose up`. Choose your own passwords.
# =============================================================================

# Superuser password for the `postgres` role created by the Docker Postgres image.
# Used by db/bootstrap_roles.sh to create confam_app and confam_migrator.
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser

# Database name to create on first container start.
POSTGRES_DB=confam

# Passwords for the two application roles (created by db/bootstrap_roles.sh).
# These must match what you put in DATABASE_URL and ALEMBIC_DATABASE_URL below.
CONFAM_APP_PASSWORD=changeme_app
CONFAM_MIGRATOR_PASSWORD=changeme_migrator


# =============================================================================
# SECTION B — Application connection strings
#
# These connect to the database created in Section A.
# For local Docker dev, use `postgres` as the host (the Docker service name).
# For local venv dev (outside Docker), use `localhost:5434` (the exposed port).
# =============================================================================

# Application runtime — connects as confam_app (restricted role, no DELETE/DDL).
# Docker:  postgresql://confam_app:${CONFAM_APP_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Local:   postgresql://confam_app:changeme_app@localhost:5434/confam
DATABASE_URL=postgresql://confam_app:changeme_app@localhost:5434/confam

# Alembic migrations only — connects as confam_migrator (full DDL/DML).
# NEVER use this URL as the application runtime connection string.
# Docker:  postgresql+psycopg2://confam_migrator:${CONFAM_MIGRATOR_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Local:   postgresql+psycopg2://confam_migrator:changeme_migrator@localhost:5434/confam
ALEMBIC_DATABASE_URL=postgresql+psycopg2://confam_migrator:changeme_migrator@localhost:5434/confam

# Test suite (mirrors CI pattern — see .github/workflows/ci.yml).
TEST_DATABASE_URL=postgresql://confam_app:changeme_app@localhost:5434/confam


# -----------------------------------------------------------------------------
# WhatsApp Business API — Meta Cloud API direct (OQ-001 updated)
#
# Switched from Twilio BSP to Meta Cloud API after hands-on testing.
# Rationale: avoids long-term per-message BSP costs.
# See OQ-001 in OPEN_QUESTIONS.md for the updated decision record.
#
# Rule 8: WHATSAPP_ACCESS_TOKEN has messaging authority — treat as highest-tier secret.
#
# confam_thread_id format: bare digits (e.g. "2348012345678")
#   Meta sends the sender ID without '+' prefix or 'whatsapp:' prefix.
#   This must match what is stored in merchants.confam_thread_id.
#
# To get these values:
#   1. Create a Meta App at developers.facebook.com
#   2. Add the WhatsApp product
#   3. Get your Phone Number ID and temporary access token from the dashboard
#   4. Set WHATSAPP_VERIFY_TOKEN to any string you choose (used for webhook verification)
#   5. Set WHATSAPP_APP_SECRET from App Settings > Basic > App Secret
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER_WHATSAPP_ACCESS_TOKEN
WHATSAPP_APP_SECRET=PLACEHOLDER_WHATSAPP_APP_SECRET
WHATSAPP_VERIFY_TOKEN=PLACEHOLDER_CHOOSE_YOUR_OWN_VERIFY_TOKEN


# -----------------------------------------------------------------------------
# Bank / Fiat Rail — Paystack (OQ-004 resolved)
#
# Rule 8: PAYSTACK_SECRET_KEY is a payout-capable credential — highest IAM
# restriction tier required in production (AWS Secrets Manager).
# -----------------------------------------------------------------------------
BANK_AGGREGATOR_PROVIDER=paystack
PAYSTACK_SECRET_KEY=PLACEHOLDER_PAYSTACK_SECRET_KEY

# HMAC-SHA512 secret for verifying inbound Paystack webhook signatures.
PAYSTACK_WEBHOOK_SECRET=PLACEHOLDER_PAYSTACK_WEBHOOK_SECRET

PAYSTACK_BASE_URL=https://api.paystack.co


# -----------------------------------------------------------------------------
# Stellar / Crypto Rail — SEP-31, stellar-sdk (OQ-005 partially resolved)
#
# Protocol: SEP-31 (direct, institution-to-institution).
# Anchor vendor: TBD — see OPEN_QUESTIONS.md OQ-005 residual.
#
# IMPORTANT: The Stellar signing key (capable of initiating a Stellar
# transaction) is NOT stored here. It lives in AWS Secrets Manager only
# (Rule 8 — payout-capable credential). Reference it by Secrets Manager ARN.
# -----------------------------------------------------------------------------
STELLAR_SEP_MODE=sep31

# Horizon server: testnet for dev, mainnet for production.
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# SEP-31 anchor base URL for stablecoin-to-naira off-ramp.
# TODO (OPEN_QUESTIONS.md OQ-005 residual): populate once a specific
# SEP-31-capable anchor with NGN payout support is selected.
STELLAR_ANCHOR_URL=PLACEHOLDER_STELLAR_ANCHOR_URL_PENDING_VENDOR_SELECTION


# -----------------------------------------------------------------------------
# AWS (OQ-007 resolved: AWS, af-south-1 preferred region)
#
# In production, use an IAM role attached to the compute resource — not static
# access keys. Access keys below are for local development only.
# Rule 8: never commit real AWS credentials.
# -----------------------------------------------------------------------------
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=PLACEHOLDER_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_AWS_SECRET_ACCESS_KEY

# AWS Secrets Manager ARN prefix for ConFam secrets.
# Runtime application fetches payout-capable secrets from Secrets Manager,
# not from environment variables, in staging/production.
AWS_SECRETS_MANAGER_PREFIX=arn:aws:secretsmanager:af-south-1:PLACEHOLDER_ACCOUNT_ID:secret:confam/


# -----------------------------------------------------------------------------
# AWS SQS — webhook processing queue (OQ-008 resolved)
# -----------------------------------------------------------------------------
SQS_WEBHOOK_QUEUE_URL=https://sqs.af-south-1.amazonaws.com/PLACEHOLDER_ACCOUNT_ID/confam-webhooks


# -----------------------------------------------------------------------------
# Settlement Engine
# -----------------------------------------------------------------------------

# Secret for signing one-time payment link tokens (itsdangerous).
# Rule 8: rotate via AWS Secrets Manager in production.
PAYMENT_LINK_SIGNING_SECRET=PLACEHOLDER_LINK_SIGNING_SECRET

# Payment link expiry in seconds (OQ-012 resolved: 30 minutes).
PAYMENT_LINK_EXPIRY_SECONDS=1800

# Payout account change cooling-off window in seconds (Rule 5 / OQ-021).
# Default: 172800 = 48 hours. Set to a small value (e.g. 10) for local testing.
# Never set to 0 in staging/production — the cooling-off window is the security control.
PAYOUT_ACCOUNT_COOLING_OFF_SECONDS=172800


# -----------------------------------------------------------------------------
# Observability (OQ-009 resolved: structlog + Sentry + CloudWatch)
# -----------------------------------------------------------------------------
SENTRY_DSN=PLACEHOLDER_SENTRY_DSN
LOG_LEVEL=DEBUG

# Reconciliation job lookback window in minutes (OQ-013 / Rule 7).
# The job fetches Paystack transactions from this far back on each run.
# Set slightly longer than the run interval (default 15 min) to catch edge cases.
RECONCILIATION_LOOKBACK_MINUTES=20


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000

# Base URL for generated payment links shared with buyers.
# Production: https://pay.confam.co (OQ-011 resolved: generic domain, no per-merchant subdomain).
CHECKOUT_BASE_URL=http://localhost:8001
